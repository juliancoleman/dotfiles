// Niri compositor config
// Docs: https://niri-wm.github.io/niri/Configuration:-Introduction

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

gestures {
    hot-corners {
        off
    }
}

// ── Monitors ───────────────────────────────────────────────────
// Desktop (DP-2): panel preferred mode is 60Hz — set 165Hz explicitly.
// Harmless on MacBook where DP-2 is absent.
output "DP-2" {
    mode "2560x1440@165.000"
    focus-at-startup
}

// ── Cursor ─────────────────────────────────────────────────────
cursor {
    xcursor-theme "catppuccin-latte-light-cursors"
    xcursor-size 24
}

// ── Environment ────────────────────────────────────────────────
environment {
    QT_QPA_PLATFORM "wayland"
    XDG_SESSION_TYPE "wayland"
}

// ── Appearance ─────────────────────────────────────────────────
layout {
    background-color "transparent"
    gaps 12
    struts {
        left 12
        right 12
        top 12
        bottom 12
    }
    focus-ring {
        on
        width 1
        active-color "#00bcd4"
        inactive-color "#00000000"
    }
    border {
        width 1
        active-color "#00bcd4"
        inactive-color "#00000000"
    }
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}
// Stable internal workspace identities; UI and keybindings expose digits only.
workspace "ws1"
workspace "ws2"
workspace "ws3"
workspace "ws4"

// Quickshell and swaybg start as supervised systemd user services.
spawn-at-startup "xwayland-satellite"
spawn-at-startup "udiskie" "--notify" "--auto-mount"
// Keep the MacBook reachable during unattended development. The desktop
// continues to use hypridle; explicit locking remains bound below.
spawn-at-startup "sh" "-c" "[ \"$(hostname)\" = macbook-pro ] || exec hypridle"

xwayland-satellite {
    path "xwayland-satellite"
}

hotkey-overlay {
    skip-at-startup
}

// ── Keybindings ────────────────────────────────────────────────
binds {
    // Essentials
    Super+Return { spawn "ghostty"; }
    Super+Space { spawn "fuzzel"; }
    Super+Alt+L { spawn-sh "$HOME/dotfiles/nixos/niri/lock.sh"; }
    Super+U { spawn-sh "$HOME/dotfiles/nixos/niri/open-usb.sh"; }
    Super+Q { close-window; }
    Super+Shift+E { quit; }

    // Floating / fullscreen
    Super+V { toggle-window-floating; }
    Super+F { spawn "nautilus"; }
    Super+Shift+F { fullscreen-window; }

    // Focus movement
    Super+Left  { focus-column-left; }
    Super+Right { focus-column-right; }
    Super+Up    { focus-window-up; }
    Super+Down  { focus-window-down; }

    // Move windows
    Super+Shift+Left  { move-column-left; }
    Super+Shift+Right { move-column-right; }
    Super+Shift+Up    { move-window-up; }
    Super+Shift+Down  { move-window-down; }

    // Four persistent workspaces addressed by stable names.
    Super+1 { focus-workspace "ws1"; }
    Super+2 { focus-workspace "ws2"; }
    Super+3 { focus-workspace "ws3"; }
    Super+4 { focus-workspace "ws4"; }

    Super+Shift+1 { move-column-to-workspace "ws1"; }
    Super+Shift+2 { move-column-to-workspace "ws2"; }
    Super+Shift+3 { move-column-to-workspace "ws3"; }
    Super+Shift+4 { move-column-to-workspace "ws4"; }

    // Column / window sizing
    Super+R { switch-preset-column-width; }
    Super+Ctrl+F { expand-column-to-available-width; }
    Super+Minus { set-column-width "-10%"; }
    Super+Equal { set-column-width "+10%"; }
    Super+Shift+Minus { set-window-height "-10%"; }
    Super+Shift+Equal { set-window-height "+10%"; }

    // Center column
    Super+M { center-column; }

    // Media keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "qs-ipc" "status" "brightnessUp"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "qs-ipc" "status" "brightnessDown"; }
    XF86AudioNext  allow-when-locked=true { spawn "qs-ipc" "status" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "qs-ipc" "status" "playPause"; }
    XF86AudioPlay  allow-when-locked=true { spawn "qs-ipc" "status" "playPause"; }
    XF86AudioPrev  allow-when-locked=true { spawn "qs-ipc" "status" "previous"; }

    // Screenshot
    Print { spawn-sh "$HOME/dotfiles/nixos/niri/screenshot.sh"; }
    Super+Shift+S { spawn-sh "$HOME/dotfiles/nixos/niri/screenshot-region.sh"; }
}

// ── Window rules ───────────────────────────────────────────────
prefer-no-csd
window-rule {
    geometry-corner-radius 12
    draw-border-with-background false
    clip-to-geometry true
}
window-rule {
    match app-id="brave-browser"
    open-on-workspace "ws1"
}

window-rule {
    match app-id="com.mitchellh.ghostty"
    open-on-workspace "ws2"
}

// Blur Quickshell panels and popovers without blurring the reserved bar strip.
layer-rule {
    match namespace="^qs:panel$"
    background-effect {
        blur true
        xray false
        noise 0.02
        saturation 1.05
    }
}

// ── Animations ─────────────────────────────────────────────────
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=6000 epsilon=0.0001
    }
    window-open {
        duration-ms 30
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 30
        curve "ease-out-expo"
    }
    window-movement {
        duration-ms 30
        curve "ease-out-expo"
    }
    window-resize {
        duration-ms 30
        curve "ease-out-expo"
    }
}